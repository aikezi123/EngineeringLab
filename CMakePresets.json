{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-msvc-x64",
      "description": "MSVC x64 共享配置：启用 vcpkg 工具链，并选用动态 MSVC 运行库配合静态第三方库的 triplet。",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "ninja-msvc-debug",
      "displayName": "Ninja + MSVC Debug",
      "description": "Ninja + MSVC Debug，导出 compile_commands.json。cacheVariables 相当于配置时传入 -D变量=值：ENGINEERINGLAB_ENABLE_CUDA=ON 开启项目 CUDA；$env{CUDA_PATH} 读取环境变量并拼接 nvcc 路径；CMAKE_CUDA_ARCHITECTURES=75 指定 GPU 计算能力 7.5（RTX 2060），不是 Toolkit 版本。",
      "inherits": "vcpkg-msvc-x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "ENGINEERINGLAB_ENABLE_CUDA": "ON",
        "CMAKE_CUDA_COMPILER": "$env{CUDA_PATH}/bin/nvcc.exe",
        "CMAKE_CUDA_ARCHITECTURES": "75"
      }
    },
    {
      "name": "ninja-msvc-release",
      "displayName": "Ninja + MSVC Release",
      "description": "Ninja + MSVC Release，启用优化。与 Debug 相同，ON 开启 CUDA，$env{CUDA_PATH}/bin/nvcc.exe 指定 CUDA 编译器，75 指定 GPU 计算能力 7.5；Toolkit 安装目录由本机环境变量提供。",
      "inherits": "vcpkg-msvc-x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "ENGINEERINGLAB_ENABLE_CUDA": "ON",
        "CMAKE_CUDA_COMPILER": "$env{CUDA_PATH}/bin/nvcc.exe",
        "CMAKE_CUDA_ARCHITECTURES": "75"
      }
    },
    {
      "name": "ninja-msvc-asan",
      "displayName": "Ninja + MSVC AddressSanitizer",
      "description": "inherits 继承 Debug，当前 cacheVariables 覆盖同名配置：开启 ASan、关闭 CUDA。null 表示此 preset 不再设置从 Debug 继承的 CUDA 编译器和架构值；它不是字符串，也不负责删除已有 CMakeCache.txt 中的条目。",
      "inherits": "ninja-msvc-debug",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "ENGINEERINGLAB_ENABLE_ASAN": "ON",
        "ENGINEERINGLAB_ENABLE_CUDA": "OFF",
        "CMAKE_CUDA_COMPILER": null,
        "CMAKE_CUDA_ARCHITECTURES": null
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-msvc-debug",
      "description": "构建 ninja-msvc-debug 配置。",
      "configurePreset": "ninja-msvc-debug"
    },
    {
      "name": "ninja-msvc-release",
      "description": "构建 ninja-msvc-release 配置。",
      "configurePreset": "ninja-msvc-release"
    },
    {
      "name": "ninja-msvc-asan",
      "description": "构建 ninja-msvc-asan 配置。",
      "configurePreset": "ninja-msvc-asan"
    }
  ],
  "testPresets": [
    {
      "name": "ninja-msvc-debug",
      "displayName": "Ninja + MSVC Debug Tests",
      "description": "运行 Debug 构建目录中由 CTest 注册的全部测试。",
      "configurePreset": "ninja-msvc-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ninja-msvc-release",
      "displayName": "Ninja + MSVC Release Tests",
      "description": "运行 Release 构建目录中由 CTest 注册的全部测试。",
      "configurePreset": "ninja-msvc-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ninja-msvc-asan",
      "displayName": "Ninja + MSVC AddressSanitizer Tests",
      "description": "在 AddressSanitizer 配置下运行全部测试。",
      "configurePreset": "ninja-msvc-asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
